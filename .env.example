# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# The app does not read this file itself; load it into your shell with:
#   set -a; source .env; set +a

# Anthropic credentials for the agent's LLM.
ANTHROPIC_API_KEY=

# Deepgram credentials for speech-to-text and text-to-speech.
DEEPGRAM_API_KEY=

# Optional. Uncomment only with a real value; an empty value counts as set.
# COLLECTWISE_SESSION_SECRET=<at least 32 random characters>
# COLLECTWISE_ADMIN_KEY=<at least 32 random characters; sent as X-Admin-Key>
# COLLECTWISE_AGENT_MODEL=claude-sonnet-5-5
# COLLECTWISE_AGENT_EFFORT=medium
# COLLECTWISE_STT_MODEL=nova-3
# COLLECTWISE_TTS_VOICE=aura-2-thalia-en
# COLLECTWISE_VOICE_MIN_CONFIDENCE=0.6
# COLLECTWISE_SESSION_IDLE_MINUTES=15
# COLLECTWISE_MAX_SESSIONS_PER_CUSTOMER=3
# COLLECTWISE_MAX_SESSIONS=1000
# COLLECTWISE_MAX_CALLER_TURNS=30
# COLLECTWISE_TURNS_PER_MINUTE=10
# COLLECTWISE_SESSION_STARTS_PER_MINUTE=5
# COLLECTWISE_PAYMENT_CONFIRM_TURNS=2
# COLLECTWISE_PAYMENT_CONFIRM_MINUTES=5

# Deliberately not here: COLLECTWISE_AGENT_LLM=anthropic and
# COLLECTWISE_SPEECH=deepgram. They enable real (paid) calls; set them on the
# command line for each run instead.
