# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# The app does not read this file itself; load it into your shell with:
#   set -a; source .env; set +a

# Anthropic credentials for the agent's LLM.
ANTHROPIC_API_KEY=

# Optional. Uncomment only with a real value; an empty value counts as set.
# COLLECTWISE_SESSION_SECRET=<at least 32 random characters>
# COLLECTWISE_AGENT_MODEL=claude-sonnet-5-5
# COLLECTWISE_AGENT_EFFORT=medium

# Deliberately not here: COLLECTWISE_AGENT_LLM=anthropic. It enables real
# (paid) model calls; set it on the command line for each run instead.
